# Optional — only needed to enable the AI explanation layer.
# The deterministic analysis engine works fully without this.
ANTHROPIC_API_KEY=

# Comma-separated list of exact origins allowed to call this API,
# e.g. https://autopsy.example.com,https://staging.autopsy.example.com
# Leave unset for local dev (defaults to "*") — always set this before
# deploying anywhere public.
ALLOWED_ORIGINS=

# Rate limit for POST /api/analyze, per client IP. Default: 5/minute.
ANALYZE_RATE_LIMIT=5/minute
